# Supabase project credentials
# Copy to .env for local reference (do not commit .env).
# Recommended on Windows (avoids broken JWT keys in PowerShell):
#
#   1. Copy env.dev.json.example → env.dev.json
#   2. Paste Project URL + anon key from Supabase → Project Settings → API
#   3. Run:  .\scripts\run_dublin.ps1
#
# Or manually:
#   flutter run -d chrome --dart-define-from-file=env.dev.json

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
MARKET=dublin
